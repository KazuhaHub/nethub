+        self.pin_record()
+
+    def test_missing_extra_or_changed_generated_cache_files_are_rejected(self):
+        path = self.cache / 'FRP_VERSION'
+        path.unlink()
+        with self.assertRaisesRegex(ValueError, 'missing'):
