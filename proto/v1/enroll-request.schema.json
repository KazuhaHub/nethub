{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/nethub/v1/enroll-request.schema.json",
  "type": "object",
  "properties": {
    "agent_protocol_version": {
      "$ref": "common.schema.json#/$defs/version"
    },
    "enroll_token": {
      "$ref": "common.schema.json#/$defs/secret"
    },
    "platform": {
      "$ref": "common.schema.json#/$defs/platform"
    },
    "platform_version": {
      "$ref": "common.schema.json#/$defs/short_text"
    },
    "agent_version": {
      "$ref": "common.schema.json#/$defs/short_text"
    },
    "capabilities": {
      "$ref": "common.schema.json#/$defs/capabilities"
    },
    "hostname": {
      "$ref": "common.schema.json#/$defs/hostname"
    },
    "gui_public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{121}[AQgw]$",
      "minLength": 122,
      "maxLength": 122
    },
    "cluster_hint": {
      "type": "boolean"
    }
  },
  "required": [
    "agent_protocol_version",
    "enroll_token",
    "platform",
    "platform_version",
    "agent_version",
    "capabilities",
    "hostname",
    "cluster_hint"
  ],
  "additionalProperties": true,
  "maxProperties": 24
}
