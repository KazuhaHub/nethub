{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/nethub/v1/certificate-issued-response.schema.json",
  "type": "object",
  "properties": {
    "agent_protocol_version": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/version"
        },
        {
          "pattern": "^1\\.(?:[3-9]|[1-9][0-9]+)\\."
        }
      ]
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "assigned_host": {
      "$ref": "common.schema.json#/$defs/gui_assigned_host"
    },
    "gui_key_fingerprint": {
      "$ref": "common.schema.json#/$defs/sha256"
    },
    "request": {
      "$ref": "common.schema.json#/$defs/certificate_record"
    },
    "issued": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "generation_id": {
              "$ref": "common.schema.json#/$defs/uuid"
            },
            "generation": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "chain_pem": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32768
            },
            "leaf_fingerprint": {
              "$ref": "common.schema.json#/$defs/sha256"
            },
            "not_before": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "not_after": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "valid_until": {
              "$ref": "common.schema.json#/$defs/timestamp"
            },
            "renew_after": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          },
          "required": [
            "generation_id",
            "generation",
            "chain_pem",
            "leaf_fingerprint",
            "not_before",
            "not_after",
            "valid_until",
            "renew_after"
          ],
          "additionalProperties": true,
          "maxProperties": 24
        }
      ]
    }
  },
  "required": [
    "agent_protocol_version",
    "device_id",
    "assigned_host",
    "gui_key_fingerprint",
    "request",
    "issued"
  ],
  "additionalProperties": true,
  "maxProperties": 22
}
