{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "agent_protocol_version": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/version"
        },
        {
          "pattern": "^1\\.(?:[7-9]|[1-9][0-9]+)\\."
        }
      ]
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "accepted": {
      "const": true
    },
    "revoked": {
      "type": "boolean"
    },
    "event_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 36,
        "maxLength": 36,
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
        "not": {
          "pattern": "[\\x00-\\x1f\\x7f]"
        }
      }
    }
  },
  "additionalProperties": true,
  "$id": "https://schemas.example.com/nethub/v1/reconcile-audit-response.schema.json",
  "required": [
    "agent_protocol_version",
    "device_id",
    "accepted",
    "revoked",
    "event_ids"
  ],
  "maxProperties": 21
}
