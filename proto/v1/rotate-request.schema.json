{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/nethub/v1/rotate-request.schema.json",
  "type": "object",
  "properties": {
    "agent_protocol_version": {
      "allOf": [
        {
          "$ref": "common.schema.json#/$defs/version"
        },
        {
          "pattern": "^1\\.(?:[6-9]|[1-9][0-9]+)\\."
        }
      ]
    },
    "device_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "operation_id": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "replacement_secret": {
      "$ref": "common.schema.json#/$defs/secret"
    }
  },
  "required": [
    "agent_protocol_version",
    "device_id",
    "operation_id",
    "replacement_secret"
  ],
  "additionalProperties": true,
  "maxProperties": 20
}
