{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/nethub/v1/domain-claim.schema.json",
  "type": "object",
  "properties": {
    "device_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "subdomain": {
      "$ref": "common.schema.json#/$defs/subdomain"
    },
    "tenant_id": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "issued_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "key_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
    }
  },
  "required": [
    "device_id",
    "subdomain",
    "tenant_id",
    "issued_at",
    "key_id"
  ],
  "additionalProperties": false,
  "maxProperties": 5
}
