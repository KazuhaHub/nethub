{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.example.com/nethub/v1/common.schema.json",
  "$defs": {
    "version": {
      "type": "string",
      "minLength": 5,
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*)?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "uuid": {
      "type": "string",
      "minLength": 36,
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "secret": {
      "type": "string",
      "minLength": 43,
      "maxLength": 43,
      "pattern": "^[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "platform": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "pattern": "^[a-z][a-z0-9-]{0,31}$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 253,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9-]{0,61}[A-Za-z0-9])?)*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "subdomain": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 64,
        "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9]*)+$",
        "not": {
          "pattern": "[\\x00-\\x1f\\x7f]"
        }
      }
    },
    "short_text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 128,
      "pattern": "^[\\x20-\\x7e]*$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "claim": {
      "type": "string",
      "minLength": 45,
      "maxLength": 3116,
      "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 27,
      "maxLength": 27,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{6}Z$",
      "not": {
        "pattern": "[\\x00-\\x1f\\x7f]"
      }
    }
  }
}
